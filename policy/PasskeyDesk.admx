          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <enum id="Profile3RandomPin" valueName="Profile3RandomPin" required="true">
          <item displayName="$(string.Off)">
            <value>
