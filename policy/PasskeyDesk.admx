          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <decimal id="Profile1RandomPinLength" valueName="RandomPinLength" required="true" minValue="0" maxValue="63" />
        <decimal id="Profile1MinPinLength" valueName="MinPinLength" required="true" minValue="0" maxValue="63" />
        <enum id="Profile1ForcePinChange" valueName="ForcePinChange" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <enum id="Profile1AlwaysUv" valueName="AlwaysUv" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <enum id="Profile1RequireEa" valueName="RequireEa" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
      </elements>
    </policy>
