            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <enum id="Profile2RequireEa" valueName="Profile2RequireEa" required="true">
          <item displayName="$(string.Off)">
