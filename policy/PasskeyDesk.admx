    <policy name="Activity" class="Machine" key="Software\Policies\PasskeyDesk\AppSettings\Logging\Activity" displayName="$(string.ActivityLabel)" explainText="$(string.ActivityHelp)" presentation="$(presentation.Activity)">
      <parentCategory ref="Logging" />
      <supportedOn ref="PolicyPreview" />
      <elements>
        <enum id="ActivityEnabled" valueName="Enabled" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <decimal id="ActivityRetentionDays" valueName="RetentionDays" required="true" minValue="1" maxValue="3650" />
        <text id="ActivityFolder" valueName="Folder" required="false" maxLength="32767" />
      </elements>
    </policy>
    <policy name="Registration" class="Machine" key="Software\Policies\PasskeyDesk\AppSettings\Logging\Registration" displayName="$(string.RegistrationLabel)" explainText="$(string.RegistrationHelp)" presentation="$(presentation.Registration)">
