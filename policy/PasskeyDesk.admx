<?xml version='1.0' encoding='utf-8'?>
<policyDefinitions revision="1.4" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="pdesk" namespace="PasskeyDesk.Policies" />
  </policyNamespaces>
  <resources minRequiredRevision="1.4" />
  <supportedOn>
    <definitions>
      <definition name="PolicyPreview" displayName="$(string.SupportedVersion)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="PasskeyDesk" displayName="$(string.CategoryName)" />
    <category name="CliConfig" displayName="$(string.CliConfigLabelCategory)">
      <parentCategory ref="PasskeyDesk" />
    </category>
    <category name="TenantsCategory" displayName="$(string.TenantsCategoryLabelCategory)">
      <parentCategory ref="CliConfig" />
    </category>
    <category name="Profiles" displayName="$(string.ProfilesLabelCategory)">
      <parentCategory ref="CliConfig" />
    </category>
    <category name="AppSettings" displayName="$(string.AppSettingsLabelCategory)">
      <parentCategory ref="PasskeyDesk" />
    </category>
    <category name="Logging" displayName="$(string.LoggingLabelCategory)">
      <parentCategory ref="AppSettings" />
    </category>
  </categories>
  <policies>
    <policy name="Tenants" class="Machine" key="Software\Policies\PasskeyDesk\YubiEnroll\Tenants" displayName="$(string.TenantsLabel)" explainText="$(string.TenantsHelp)" presentation="$(presentation.Tenants)">
      <parentCategory ref="TenantsCategory" />
      <supportedOn ref="PolicyPreview" />
      <elements>
        <text id="TenantsTenantsJson" valueName="TenantsJson" required="true" maxLength="1048576" />
      </elements>
    </policy>
    <policy name="Activity" class="Machine" key="Software\Policies\PasskeyDesk\AppSettings\Logging\Activity" displayName="$(string.ActivityLabel)" explainText="$(string.ActivityHelp)" presentation="$(presentation.Activity)">
      <parentCategory ref="Logging" />
      <supportedOn ref="PolicyPreview" />
      <elements>
        <enum id="ActivityEnabled" valueName="Enabled" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <decimal id="ActivityRetentionDays" valueName="RetentionDays" required="true" minValue="1" maxValue="3650" />
        <text id="ActivityFolder" valueName="Folder" required="false" maxLength="32767" />
      </elements>
    </policy>
    <policy name="Registration" class="Machine" key="Software\Policies\PasskeyDesk\AppSettings\Logging\Registration" displayName="$(string.RegistrationLabel)" explainText="$(string.RegistrationHelp)" presentation="$(presentation.Registration)">
      <parentCategory ref="Logging" />
      <supportedOn ref="PolicyPreview" />
      <elements>
        <enum id="RegistrationEnabled" valueName="Enabled" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <enum id="RegistrationSaveGeneratedPin" valueName="SaveGeneratedPin" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <text id="RegistrationFolder" valueName="Folder" required="false" maxLength="32767" />
        <decimal id="RegistrationRetentionDays" valueName="RetentionDays" required="true" minValue="1" maxValue="3650" />
      </elements>
    </policy>
    <policy name="Terminal" class="Machine" key="Software\Policies\PasskeyDesk\AppSettings\Terminal" displayName="$(string.TerminalLabel)" explainText="$(string.TerminalHelp)" presentation="$(presentation.Terminal)">
      <parentCategory ref="AppSettings" />
      <supportedOn ref="PolicyPreview" />
      <elements>
        <enum id="TerminalEmbeddedTerminal" valueName="EmbeddedTerminal" required="true">
          <item displayName="$(string.External)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.Internal)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
      </elements>
    </policy>
    <policy name="Profile1" class="Machine" key="Software\Policies\PasskeyDesk\YubiEnroll\Profiles\Profile1" displayName="$(string.Profile1Label)" explainText="$(string.Profile1Help)" presentation="$(presentation.Profile1)">
      <parentCategory ref="Profiles" />
      <supportedOn ref="PolicyPreview" />
      <elements>
        <text id="Profile1Name" valueName="Name" required="true" maxLength="80" />
        <enum id="Profile1Reset" valueName="Reset" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <enum id="Profile1RandomPin" valueName="RandomPin" required="true">
          <item displayName="$(string.Off)">
            <value>
