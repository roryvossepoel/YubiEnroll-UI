<?xml version='1.0' encoding='utf-8'?>
<policyDefinitions revision="1.3" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="pdesk" namespace="PasskeyDesk.Policies" />
  </policyNamespaces>
  <resources minRequiredRevision="1.3" />
  <supportedOn>
    <definitions>
      <definition name="PolicyPreview" displayName="$(string.SupportedVersion)" />
      <definition name="PolicyPreview5" displayName="$(string.SupportedVersion5)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="PasskeyDesk" displayName="$(string.CategoryName)" />
    <category name="CliConfig" displayName="$(string.CliConfigLabelCategory)">
      <parentCategory ref="PasskeyDesk" />
    </category>
    <category name="TenantsCategory" displayName="$(string.TenantsCategoryLabelCategory)">
      <parentCategory ref="CliConfig" />
    </category>
    <category name="Profiles" displayName="$(string.ProfilesLabelCategory)">
      <parentCategory ref="CliConfig" />
    </category>
    <category name="AppSettings" displayName="$(string.AppSettingsLabelCategory)">
      <parentCategory ref="PasskeyDesk" />
    </category>
    <category name="Logging" displayName="$(string.LoggingLabelCategory)">
      <parentCategory ref="AppSettings" />
    </category>
  </categories>
  <policies>
    <policy name="Tenants" class="Machine" key="Software\Policies\PasskeyDesk" displayName="$(string.TenantsLabel)" explainText="$(string.TenantsHelp)" presentation="$(presentation.Tenants)">
      <parentCategory ref="TenantsCategory" />
      <supportedOn ref="PolicyPreview" />
      <elements>
        <text id="TenantsJson" valueName="TenantsJson" required="true" maxLength="1048576" />
      </elements>
    </policy>
    <policy name="Activity" class="Machine" key="Software\Policies\PasskeyDesk" displayName="$(string.ActivityLabel)" explainText="$(string.ActivityHelp)" presentation="$(presentation.Activity)">
      <parentCategory ref="Logging" />
      <supportedOn ref="PolicyPreview" />
      <elements>
        <enum id="ActivityLogging" valueName="ActivityLogging" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <decimal id="RetentionDays" valueName="RetentionDays" required="true" minValue="1" maxValue="3650" />
        <text id="ActivityFolder" valueName="ActivityFolder" required="false" maxLength="32767" />
      </elements>
    </policy>
    <policy name="Registration" class="Machine" key="Software\Policies\PasskeyDesk" displayName="$(string.RegistrationLabel)" explainText="$(string.RegistrationHelp)" presentation="$(presentation.Registration)">
      <parentCategory ref="Logging" />
      <supportedOn ref="PolicyPreview5" />
      <elements>
        <enum id="RegistrationLogging" valueName="RegistrationLogging" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <enum id="SaveGeneratedPin" valueName="SaveGeneratedPin" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <text id="RegistrationFolder" valueName="RegistrationFolder" required="false" maxLength="32767" />
        <decimal id="RegistrationRetentionDays" valueName="RegistrationRetentionDays" required="true" minValue="1" maxValue="3650" />
      </elements>
    </policy>
    <policy name="Terminal" class="Machine" key="Software\Policies\PasskeyDesk" displayName="$(string.TerminalLabel)" explainText="$(string.TerminalHelp)" presentation="$(presentation.Terminal)">
      <parentCategory ref="AppSettings" />
      <supportedOn ref="PolicyPreview" />
      <elements>
        <enum id="EmbeddedTerminal" valueName="EmbeddedTerminal" required="true">
          <item displayName="$(string.External)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.Internal)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
      </elements>
    </policy>
    <policy name="Profile1" class="Machine" key="Software\Policies\PasskeyDesk" displayName="$(string.Profile1Label)" explainText="$(string.Profile1Help)" presentation="$(presentation.Profile1)">
      <parentCategory ref="Profiles" />
      <supportedOn ref="PolicyPreview" />
      <elements>
        <text id="Profile1Name" valueName="Profile1Name" required="true" maxLength="80" />
        <enum id="Profile1Reset" valueName="Profile1Reset" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <enum id="Profile1RandomPin" valueName="Profile1RandomPin" required="true">
          <item displayName="$(string.Off)">
            <value>
