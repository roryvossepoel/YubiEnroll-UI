        <decimal id="Profile3RandomPinLength" valueName="Profile3RandomPinLength" required="true" minValue="0" maxValue="63" />
        <decimal id="Profile3MinPinLength" valueName="Profile3MinPinLength" required="true" minValue="0" maxValue="63" />
