          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <decimal id="Profile1RandomPinLength" valueName="Profile1RandomPinLength" required="true" minValue="0" maxValue="63" />
        <decimal id="Profile1MinPinLength" valueName="Profile1MinPinLength" required="true" minValue="0" maxValue="63" />
        <enum id="Profile1ForcePinChange" valueName="Profile1ForcePinChange" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <enum id="Profile1AlwaysUv" valueName="Profile1AlwaysUv" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
        <enum id="Profile1RequireEa" valueName="Profile1RequireEa" required="true">
          <item displayName="$(string.Off)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.On)">
            <value>
              <decimal value="1" />
            </value>
          </item>
        </enum>
      </elements>
    </policy>
