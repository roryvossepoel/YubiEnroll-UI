<Window x:Class="YubiEnroll.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Settings — YubiEnroll" Width="820" Height="650" MinWidth="680" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#F5F7FA" Foreground="#172B41" FontFamily="Segoe UI" FontSize="14">
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Manage tenants, configuration profiles and application preferences." TextWrapping="Wrap" Foreground="#617084" Margin="0,6,0,0"/></StackPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button Content="Done" DockPanel.Dock="Right" Click="Done_Click" Margin="12,0,0,0"/><TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#526277" VerticalAlignment="Center"/></DockPanel>
  <TabControl x:Name="SettingsTabs">
   <TabItem Header="Tenants"><DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" Text="Configure tenants here. Connect to one from the main window." Foreground="#617084" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button Content="Add tenant" Click="AddTenant_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="EditTenantButton" Content="Edit tenant" Click="EditTenant_Click" IsEnabled="False"/><Button x:Name="RemoveTenantButton" Content="Remove" Click="RemoveTenant_Click" IsEnabled="False"/></WrapPanel>
    <ListBox x:Name="TenantList" SelectionChanged="Selection_Changed" BorderBrush="#DCE3EB" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Profile, StringFormat=Profile: {0}}" Foreground="#617084" Margin="0,4,0,0"/><TextBlock Text="{Binding TenantId}" Foreground="#7A8796" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></TabItem>
   <TabItem Header="Profiles"><DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" Text="Profiles can be shared by multiple tenants." Foreground="#617084" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button Content="New profile" Click="NewProfile_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="EditProfileButton" Content="Edit profile" Click="EditProfile_Click" IsEnabled="False"/><Button x:Name="RemoveProfileButton" Content="Remove" Click="RemoveProfile_Click" IsEnabled="False"/></WrapPanel>
    <ListBox x:Name="ProfileList" SelectionChanged="Selection_Changed" BorderBrush="#DCE3EB" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Usage}" Foreground="#617084" FontSize="12" Margin="0,5,0,8"/><ItemsControl ItemsSource="{Binding Tenants}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#E7F1F2" CornerRadius="12" Padding="9,4" Margin="0,0,6,6"><TextBlock Text="{Binding}" MaxWidth="300" TextWrapping="Wrap" Foreground="#175C61" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ListBox.ItemTemplate><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12"/></Style></ListBox.ItemContainerStyle></ListBox>
   </DockPanel></TabItem>
   <TabItem Header="Prerequisites"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="Installed components &amp; access" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="VersionInfo" Margin="0,12,0,12" TextWrapping="Wrap"/>
    <TextBlock x:Name="AccessInfo" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock x:Name="ManagerInfo" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="YubiEnroll is required for preparation. YubiKey Manager CLI 5.9.2+ (5.x) is required for key inspection and FIDO reset." Foreground="#617084" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <WrapPanel><Button Content="Recheck" Click="Recheck_Click"/><Button Content="Restart as administrator" Click="Elevate_Click"/></WrapPanel>
    <TextBlock Text="Interactive console" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <CheckBox x:Name="EmbeddedChoice" Content="Use embedded terminal (preview, this session)"/>
    <TextBlock Text="Try the Yubico prompts inside the app. Leave unchecked to use the external console. Select before starting; running commands are never restarted automatically." TextWrapping="Wrap" Foreground="#617084" Margin="0,8,0,16"/>
    <Expander Header="Technical details"><StackPanel Margin="0,12,0,0">
     <TextBlock Text="YubiEnroll executable"/><TextBox x:Name="ExecutableInfo" IsReadOnly="True" Margin="0,6,0,16" TextWrapping="Wrap"/>
     <TextBlock Text="Configuration file"/><TextBox x:Name="ConfigurationInfo" IsReadOnly="True" Margin="0,6,0,16" TextWrapping="Wrap"/>
     <TextBlock Text=".NET 10 Desktop Runtime x64 must be installed before this application can start. Configuration and sign-in belong to the current Windows account." TextWrapping="Wrap" Foreground="#617084"/>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Import / export"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
     <TextBlock Text="Export configuration" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="Save your supported tenant and profile settings to a file." TextWrapping="Wrap" Foreground="#617084" Margin="0,8,0,8"/>
     <TextBlock x:Name="ExportCounts" Margin="0,0,0,12"/>
     <Button Content="Export file…" Click="Export_Click" HorizontalAlignment="Left"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Import configuration" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="Choose a file, review its contents, then confirm replacement of your current configuration." TextWrapping="Wrap" Foreground="#617084" Margin="0,8,0,12"/>
     <Button Content="Choose file…" Click="ChooseImport_Click" HorizontalAlignment="Left"/>
     <StackPanel x:Name="ImportReview" Visibility="Collapsed" Margin="0,16,0,0">
      <TextBlock x:Name="ImportFileName" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="ImportPreview" TextWrapping="Wrap" Margin="0,12,0,12"/>
      <TextBlock Text="This replaces all current configuration; it does not merge. An exact backup is saved first. Sign-in caches are not imported or cleared. Reconnect afterward." TextWrapping="Wrap" Foreground="#9A4B0A" Margin="0,0,0,12"/>
      <WrapPanel><Button x:Name="ImportButton" Content="Replace configuration…" Click="Import_Click" IsEnabled="False"/><Button Content="Cancel import" Click="CancelImport_Click"/></WrapPanel>
     </StackPanel>
    </StackPanel></Border>
    <Expander Header="What is included?" Margin="0,16,0,0"><TextBlock Text="A TOML file containing supported Entra tenant fields and all seven profile settings. Authentication tokens, caches, generated PINs and key credentials are excluded. Other custom fields are not exported; this is not a complete backup of arbitrary custom configuration." TextWrapping="Wrap" Foreground="#617084" Margin="0,10,0,0"/></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Help &amp; About"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="YubiEnroll UI" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock Text="Community preview 0.4.0 · Windows x64" Foreground="#617084" Margin="0,8,0,16"/>
    <TextBlock Text="An independent open-source community project. Not affiliated with, sponsored by, or endorsed by Yubico. Yubico and YubiKey are trademarks of Yubico." TextWrapping="Wrap" Margin="0,0,0,18"/>
    <TextBlock Text="Our project" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
    <WrapPanel><Button Content="GitHub" Tag="https://github.com/roryvossepoel/YubiEnroll-UI" Click="Link_Click"/><Button Content="Report an issue" Tag="https://github.com/roryvossepoel/YubiEnroll-UI/issues" Click="Link_Click"/><Button Content="Testing guide" Tag="https://github.com/roryvossepoel/YubiEnroll-UI/blob/feature/initial-wpf-app/docs/TESTING.md" Click="Link_Click"/></WrapPanel>
    <TextBlock Text="Yubico software &amp; documentation" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <WrapPanel><Button Content="YubiEnroll" Tag="https://www.yubico.com/products/yubienroll/" Click="Link_Click"/><Button Content="YubiEnroll docs" Tag="https://docs.yubico.com/software/yubikey/tools/yubienroll/use-cli.html" Click="Link_Click"/><Button Content="YubiKey Manager CLI" Tag="https://developers.yubico.com/yubikey-manager/" Click="Link_Click"/></WrapPanel>
    <WrapPanel Margin="0,8,0,0"><Button Content="ykman docs" Tag="https://docs.yubico.com/software/yubikey/tools/ykman/" Click="Link_Click"/><Button Content="Authenticator docs" Tag="https://docs.yubico.com/software/yubikey/tools/authenticator/auth-guide/index.html" Click="Link_Click"/></WrapPanel>
    <TextBlock Text="License &amp; diagnostics" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
    <TextBlock Text="MIT licensed. LICENSE and THIRD-PARTY-NOTICES.md are included with the download. Yubico tools are installed separately. Activity and error details are available through View details; interactive console output and PINs are not saved to that log. External tools manage their own authentication and caches." TextWrapping="Wrap" Foreground="#617084"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>
