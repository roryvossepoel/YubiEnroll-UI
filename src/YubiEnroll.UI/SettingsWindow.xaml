<Window x:Class="YubiEnroll.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Settings — YubiEnroll" Width="820" Height="650" MinWidth="680" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#F5F7FA" Foreground="#172B41" FontFamily="Segoe UI" FontSize="14">
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Manage your tenants, enrollment profiles and local configuration." Foreground="#617084" Margin="0,6,0,0"/></StackPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button Content="Done" DockPanel.Dock="Right" IsCancel="True" Margin="12,0,0,0"/><TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#526277" VerticalAlignment="Center"/></DockPanel>
  <TabControl x:Name="SettingsTabs">
   <TabItem Header="Tenants"><DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" Text="Configure tenants here. Connect to one from the main window." Foreground="#617084" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button Content="Add tenant" Click="AddTenant_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="EditTenantButton" Content="Edit tenant" Click="EditTenant_Click" IsEnabled="False"/></WrapPanel>
    <ListBox x:Name="TenantList" SelectionChanged="Selection_Changed" BorderBrush="#DCE3EB" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Profile, StringFormat=Profile: {0}}" Foreground="#617084" Margin="0,4,0,0"/><TextBlock Text="{Binding TenantId}" Foreground="#7A8796" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></TabItem>
   <TabItem Header="Profiles"><DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" Text="Profiles can be shared by multiple tenants." Foreground="#617084" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button Content="New profile" Click="NewProfile_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="EditProfileButton" Content="Edit profile" Click="EditProfile_Click" IsEnabled="False"/></WrapPanel>
    <ListBox x:Name="ProfileList" DisplayMemberPath="Name" SelectionChanged="Selection_Changed" BorderBrush="#DCE3EB"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12"/></Style></ListBox.ItemContainerStyle></ListBox>
   </DockPanel></TabItem>
   <TabItem Header="System"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="Installed components" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="VersionInfo" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <TextBlock Text="Required: .NET 10 Desktop Runtime x64 and Yubico YubiEnroll in its standard installation location." Foreground="#617084" TextWrapping="Wrap" Margin="0,8,0,20"/>
    <TextBlock Text="YubiEnroll executable"/><TextBox x:Name="ExecutableInfo" IsReadOnly="True" Margin="0,6,0,16" TextWrapping="Wrap"/>
    <TextBlock Text="Configuration file"/><TextBox x:Name="ConfigurationInfo" IsReadOnly="True" Margin="0,6,0,16" TextWrapping="Wrap"/>
    <WrapPanel><Button Content="Recheck" Click="Recheck_Click"/><Button Content="Restart as administrator" Click="Elevate_Click"/></WrapPanel>
    <TextBlock Text="Entra sign-in" FontWeight="SemiBold" Margin="0,24,0,6"/>
    <TextBlock Text="Closing this app is not an Entra logout. YubiEnroll documents logout for Okta only. Connect again after changing tenants. Browser sign-in and any cached authentication remain managed by YubiEnroll and Microsoft." TextWrapping="Wrap" Foreground="#617084"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Import / export"><StackPanel Margin="18">
    <TextBlock Text="Move tenants and profiles together" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="Export supported Entra tenant settings and all seven profile settings to one TOML file. Sign-in tokens and authentication caches are not included. Other custom fields are excluded." TextWrapping="Wrap" Foreground="#617084" Margin="0,12,0,18"/>
    <WrapPanel><Button Content="Export configuration…" Click="Export_Click"/><Button Content="Choose import file…" Click="ChooseImport_Click"/></WrapPanel>
    <Border Background="#F0F4F8" CornerRadius="6" Padding="16" Margin="0,20,0,16"><TextBlock x:Name="ImportPreview" Text="Choose a TOML file to validate it and preview the tenants and profiles before importing." TextWrapping="Wrap" MaxHeight="180"/></Border>
    <TextBlock Text="Import replaces this Windows account's current configuration. A backup is saved first. Existing sign-in caches are not imported or cleared; reconnect afterward." TextWrapping="Wrap" Foreground="#9A4B0A" Margin="0,0,0,16"/>
    <Button x:Name="ImportButton" Content="Replace configuration…" Click="Import_Click" IsEnabled="False" HorizontalAlignment="Left"/>
   </StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
