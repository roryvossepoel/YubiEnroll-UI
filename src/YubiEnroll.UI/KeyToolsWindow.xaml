<Window x:Class="YubiEnroll.UI.KeyToolsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Key Management" Width="690" Height="760" MinWidth="540" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#F5F7FA" FontFamily="Segoe UI" FontSize="14" Foreground="#172B41" Loaded="Window_Loaded" Closing="Window_Closing">
 <DockPanel TextElement.FontFamily="Segoe UI" TextElement.FontSize="14" TextElement.Foreground="#263238" Margin="24">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
   <TextBlock Text="Key Management" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="Erase all passkeys / FIDO reset. No tenant login needed." Foreground="#617084" Margin="0,6,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <TextBlock x:Name="StatusText" Text="Checking prerequisites…" TextWrapping="Wrap" Foreground="#526277" Margin="0,0,0,12"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="CloseButton" Content="Close" Click="Close_Click" Visibility="Collapsed"/>
    <Button x:Name="ResetButton" Content="Reset FIDO…" Click="Reset_Click" IsEnabled="False" Background="#A52C36" Foreground="White"/>
   </StackPanel>
  </StackPanel>
  <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
     <StackPanel>
      <TextBlock Text="Choose the physical key" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Connect via USB. Only keys with FIDO enabled and a readable serial number can be selected." TextWrapping="Wrap" Foreground="#617084" Margin="0,8,0,12"/>
      <ComboBox x:Name="Keys" SelectionChanged="Key_Changed" AutomationProperties.Name="Key to reset">
       <ComboBox.ItemTemplate><DataTemplate><StackPanel>
        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>

       </StackPanel></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock x:Name="PinStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <WrapPanel Margin="0,10,0,0">
       <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click"/>
       <Button x:Name="DownloadButton" Content="Get YubiKey Manager CLI" Click="Download_Click"/>
       <Button x:Name="ElevateButton" Content="Restart as administrator" Click="Elevate_Click" Visibility="Collapsed"/>
      </WrapPanel>
      <TextBlock x:Name="PrerequisiteText" TextWrapping="Wrap" Foreground="#617084" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
    <Border Background="#FFF2F0" BorderBrush="#E8C2BE" BorderThickness="1" CornerRadius="8" Padding="18">
     <StackPanel>
      <TextBlock Text="Reset FIDO · erase all passkeys and the FIDO PIN" FontWeight="SemiBold" Foreground="#852D32" TextWrapping="Wrap"/>
      <TextBlock Text="Erases all FIDO2/U2F credentials and the FIDO PIN. Existing FIDO sign-ins with this key will stop working. This cannot be undone." TextWrapping="Wrap" Margin="0,8,0,8"/>
      <TextBlock Text="Registrations in Entra and other services remain and must be removed there separately. This is not a reset of PIV, OATH, OpenPGP or OTP." TextWrapping="Wrap"/>
      <TextBlock Text="Follow the console prompts to unplug, reinsert and touch the same key. Do not close the console until it finishes." TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
