<UserControl x:Class="YubiEnroll.UI.RegistrationLogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="18">
  <Border Style="{StaticResource Card}" Padding="18,14"><StackPanel>
   <CheckBox x:Name="EnabledChoice" Content="Save enrollment records" FontWeight="SemiBold" Foreground="{StaticResource Heading}"/>
   <TextBlock Text="Optional local records for key issuance. Includes user identity and the confirmed target key; never PINs, tokens or console output." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,10"/>
   <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="Save preference" Click="SavePreference_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/><TextBox x:Name="FolderPath" IsReadOnly="True" AutomationProperties.Name="Registration log folder" VerticalContentAlignment="Center"/></DockPanel>
   <TextBlock x:Name="PreferenceStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#9A4B0A" Margin="0,10,0,0"/>
  <WrapPanel Margin="0,12,0,10">
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Tenant" Margin="0,0,0,4"/><ComboBox x:Name="TenantFilter" MinWidth="180" MaxWidth="240" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" AutomationProperties.Name="Filter registrations by tenant"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="From" Margin="0,0,0,4"/><DatePicker x:Name="FromDate" Width="135" SelectedDateChanged="Filter_Changed" AutomationProperties.Name="Registration start date"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Through" Margin="0,0,0,4"/><DatePicker x:Name="ThroughDate" Width="135" SelectedDateChanged="Filter_Changed" AutomationProperties.Name="Registration end date"/></StackPanel>
   <CheckBox x:Name="SuccessOnly" Content="Successful only" VerticalAlignment="Center" Checked="SuccessFilter_Changed" Unchecked="SuccessFilter_Changed" Margin="0,12,0,8"/>
  </WrapPanel>
  <WrapPanel Margin="0,0,0,12"><Button x:Name="ExportButton" Content="Export CSV…" Click="Export_Click"/><Button Content="Open log folder" Click="OpenFolder_Click"/><Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource QuietButton}"/><Button x:Name="RetryButton" Content="Retry saving results" Click="Retry_Click" Visibility="Collapsed"/></WrapPanel>
  <TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
  <DataGrid x:Name="Records" Height="230" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionChanged="Record_Changed" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F1" BorderBrush="#DCE3EB" Background="White" AlternatingRowBackground="#FAFBFC" HeadersVisibility="Column" RowHeight="36" EnableRowVirtualization="True" AutomationProperties.Name="Enrollment records">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Recorded at" Binding="{Binding TimeLabel}" Width="195"/>
    <DataGridTextColumn Header="User" Binding="{Binding UserLabel}" Width="180"/>
    <DataGridTextColumn Header="Tenant" Binding="{Binding TenantName}" Width="150"/>
    <DataGridTextColumn Header="Target serial" Binding="{Binding TargetSerial}" Width="110"/>
    <DataGridTextColumn Header="Result" Binding="{Binding OutcomeLabel}" Width="195"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="SelectionDetails" TextWrapping="Wrap" Margin="0,12,0,0"/>
  <TextBlock Text="Success is reported by YubiEnroll, not an independent sign-in test. Reset and first-use PIN change are the configured settings. Unknown or failed attempts may still have created a credential; check Entra before retrying." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
 </StackPanel>
 </ScrollViewer>
</UserControl>
