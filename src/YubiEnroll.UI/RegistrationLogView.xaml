<UserControl IsVisibleChanged="ViewVisibility_Changed" x:Class="YubiEnroll.UI.RegistrationLogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Open log folder" Click="OpenFolder_Click"/><Button Margin="8,0,0,0" x:Name="ExportButton" Content="Export log…" ToolTip="Export filtered registrations as CSV" Click="Export_Click"/></StackPanel>
  <TextBlock Text="Registration log" Style="{StaticResource SettingsTitle}"/></DockPanel>
  <TextBlock Text="Review and export recorded registrations." Style="{StaticResource SettingsDescription}"/>
  <WrapPanel Margin="0,0,0,6"><TextBlock Text="For new registrations:" VerticalAlignment="Center" Margin="0,0,8,0"/><Border Background="#EDF2F3" Padding="8,3" CornerRadius="10"><TextBlock x:Name="PreferenceStatus"/></Border><Border x:Name="PinPill" Padding="8,3" Margin="6,0" CornerRadius="10"><TextBlock x:Name="PinStatus"/></Border></WrapPanel>
  <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#9A4B0A" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<DockPanel Margin="0,6,0,6"><ComboBox DockPanel.Dock="Right" Margin="8,0,0,0" x:Name="TenantFilter" MinWidth="180" MaxWidth="240" Height="38" VerticalContentAlignment="Center" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" AutomationProperties.Name="Filter registrations by tenant"/><Grid><TextBox x:Name="Search" AutomationProperties.Name="Search registrations" VerticalContentAlignment="Center" TextChanged="Search_Changed"/><TextBlock Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Muted}" Text="Search user, tenant or serial…"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel><Expander x:Name="Filters" Header="Filters"><WrapPanel>   <StackPanel Margin="0,0,12,8"><TextBlock Text="From" Margin="0,0,0,4"/><DatePicker x:Name="FromDate" Width="155" Height="38" VerticalContentAlignment="Center" SelectedDateChanged="Filter_Changed" AutomationProperties.Name="Registration start date"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Through" Margin="0,0,0,4"/><DatePicker x:Name="ThroughDate" Width="155" Height="38" VerticalContentAlignment="Center" SelectedDateChanged="Filter_Changed" AutomationProperties.Name="Registration end date"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Result" Margin="0,0,0,4"/><ComboBox x:Name="ResultFilter" SelectedIndex="0" Height="38" SelectionChanged="Filter_Changed"><ComboBoxItem>All results</ComboBoxItem><ComboBoxItem>Succeeded</ComboBoxItem><ComboBoxItem>Failed or interrupted</ComboBoxItem><ComboBoxItem>Unknown</ComboBoxItem></ComboBox></StackPanel><Button x:Name="ClearFiltersButton" Content="Clear filters" Click="Clear_Click" Height="38" Padding="14,4" Margin="0,0,0,8" VerticalAlignment="Bottom"/>
  </WrapPanel></Expander>
  <WrapPanel Margin="0,0,0,12"><Button x:Name="RetryButton" Content="Retry saving results" Click="Retry_Click" Visibility="Collapsed"/></WrapPanel>
  <TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
</StackPanel>  <Grid><DataGrid x:Name="Records" RowDetailsVisibilityMode="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F1" BorderBrush="#DCE3EB" Style="{StaticResource LogTable}" AlternatingRowBackground="#F6F8F9" HeadersVisibility="Column" MinRowHeight="44" EnableRowVirtualization="True" AutomationProperties.Name="Enrollment records">
   <DataGrid.Resources>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Date/time" Binding="{Binding ListTimeLabel}" Width="Auto"/>
    <DataGridTextColumn Header="Tenant" Binding="{Binding TenantName}" Width="Auto"/>
    <DataGridTextColumn Header="User" Binding="{Binding UserLabel}" Width="Auto" MinWidth="120"/>
    <DataGridTemplateColumn Header="Key info" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding KeyModel}"/><TextBlock Text="{Binding TargetSerial}" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="PIN" Width="158" MinWidth="145" CanUserSort="False">
     <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
      <TextBlock x:Name="Unavailable" Visibility="Collapsed" Text="{Binding PinUnavailableLabel}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
      <Grid x:Name="PinControls" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
       <Grid MaxWidth="80" Margin="0,0,4,0" VerticalAlignment="Center" TextElement.FontFamily="Consolas" TextElement.FontSize="15">
        <TextBlock Text="{Binding PinLayoutSample}" Visibility="Hidden" TextWrapping="Wrap"/>
        <TextBlock x:Name="PinValue" Text="••••••" TextWrapping="Wrap" VerticalAlignment="Center"/>
       </Grid>
       <ToggleButton Grid.Column="1" x:Name="Reveal" Content="Show PIN" ToolTip="{Binding Content,RelativeSource={RelativeSource Self}}"
         Width="32" Height="26" VerticalAlignment="Center" Cursor="Hand" AutomationProperties.Name="{Binding Content,RelativeSource={RelativeSource Self}}"
         Checked="Pin_Checked" Unchecked="Pin_Unchecked" DataContextChanged="PinContext_Changed" Unloaded="Pin_Unloaded">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
         <Border x:Name="Chrome" Padding="4,2" BorderThickness="1" CornerRadius="5" Background="Transparent" BorderBrush="Transparent">
          <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
           <Path Stroke="{StaticResource Heading}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M1,10 Q10,-2 19,10 Q10,22 1,10 Z M12.5,10 A2.5,2.5 0 1 1 7.5,10 A2.5,2.5 0 1 1 12.5,10"/>
           <Path x:Name="Slash" Visibility="Collapsed" Stroke="{StaticResource Heading}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,2 L17,18"/>
          </Grid>
         </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E6EDF0"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Slash" Property="Visibility" Value="Visible"/><Setter TargetName="Chrome" Property="Background" Value="#E3F0F5"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Heading}"/></Trigger>
         </ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
       </ToggleButton>
      </Grid>
      <TextBlock x:Name="ChangeHint" Text="Change on first use" Foreground="{StaticResource Muted}" FontSize="13" Visibility="Collapsed"
                 ToolTip="The profile required a PIN change at the time of registration."/>
     </StackPanel><DataTemplate.Triggers>
       <DataTrigger Binding="{Binding ForcePinChangeOnFirstUse}" Value="True"><Setter TargetName="ChangeHint" Property="Visibility" Value="Visible"/></DataTrigger>
       <Trigger SourceName="Reveal" Property="IsChecked" Value="True">
        <Setter TargetName="PinValue" Property="Text" Value="{Binding GeneratedPin}"/><Setter TargetName="Reveal" Property="Content" Value="Hide PIN"/>
       </Trigger>
       <DataTrigger Binding="{Binding GeneratedPin}" Value="{x:Null}"><Setter TargetName="PinControls" Property="Visibility" Value="Collapsed"/><Setter TargetName="Unavailable" Property="Visibility" Value="Visible"/></DataTrigger>
      </DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Result" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="12"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFF2E1"/><Style.Triggers><DataTrigger Binding="{Binding Outcome}" Value="Succeeded"><Setter Property="Background" Value="#EAF4D6"/></DataTrigger><DataTrigger Binding="{Binding Outcome}" Value="FailedOrInterrupted"><Setter Property="Background" Value="#FBECEE"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding OutcomeLabel}" Foreground="#263238" FontSize="12"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="Copy" Width="Auto" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LogCopyButton}" ToolTip="Copy this registration as a CSV row" AutomationProperties.Name="Copy registration as CSV" Click="CopyRow_Click"><Path Width="15" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M6,5 H15 V17 H6 Z M3,13 H2 V1 H11 V2"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>

 </DataGrid><TextBlock x:Name="EmptyMessage" Margin="12,58,12,0" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></Grid></DockPanel></UserControl>