<UserControl x:Class="YubiEnroll.UI.RegistrationLogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="18">
  <TextBlock Text="Registration log" Style="{StaticResource SettingsTitle}"/>
  <TextBlock Text="Review recorded registrations and export the results for key issuance." Style="{StaticResource SettingsDescription}"/>
  <Expander x:Name="LoggingPreferences" Header="Logging preferences" Margin="0,0,0,8">
  <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,10,0,0"><StackPanel>
   <CheckBox x:Name="EnabledChoice" Content="Save enrollment records" FontWeight="SemiBold" Foreground="{StaticResource Heading}"/>
   <TextBlock Text="Record the recipient, target key, configured options and registration result." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,10"/>
   <CheckBox x:Name="SavePinChoice" Content="Save generated PINs in the registration log" IsEnabled="{Binding IsChecked, ElementName=EnabledChoice}" Margin="0,2,0,8"/>
   <TextBlock Text="When enabled, generated initial PINs are included in the log files and CSV exports. Existing PINs are never captured. Key setup uses the in-app terminal to read the generated PIN." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16"/>
   <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="Save preference" Click="SavePreference_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/><TextBox x:Name="FolderPath" IsReadOnly="True" AutomationProperties.Name="Registration log folder" VerticalContentAlignment="Center"/></DockPanel>
  </StackPanel></Border>
  </Expander>
  <TextBlock x:Name="PreferenceStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,8"/>
  <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#9A4B0A" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <WrapPanel Margin="0,12,0,10">
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Tenant" Margin="0,0,0,4"/><ComboBox x:Name="TenantFilter" MinWidth="180" MaxWidth="240" Height="38" VerticalContentAlignment="Center" DisplayMemberPath="Label" SelectionChanged="Filter_Changed" AutomationProperties.Name="Filter registrations by tenant"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="From" Margin="0,0,0,4"/><DatePicker x:Name="FromDate" Width="155" Height="38" VerticalContentAlignment="Center" SelectedDateChanged="Filter_Changed" AutomationProperties.Name="Registration start date"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Through" Margin="0,0,0,4"/><DatePicker x:Name="ThroughDate" Width="155" Height="38" VerticalContentAlignment="Center" SelectedDateChanged="Filter_Changed" AutomationProperties.Name="Registration end date"/></StackPanel>
   <CheckBox x:Name="SuccessOnly" Content="Successful only" VerticalAlignment="Center" Checked="SuccessFilter_Changed" Unchecked="SuccessFilter_Changed" Margin="0,12,0,8"/>
  </WrapPanel>
  <WrapPanel Margin="0,0,0,12"><Button x:Name="ExportButton" Content="Export CSV…" Click="Export_Click"/><Button Content="Open log folder" Click="OpenFolder_Click"/><Button Content="Refresh" ContentTemplate="{StaticResource RefreshContent}" Click="Refresh_Click" Style="{StaticResource QuietButton}"/><Button x:Name="RetryButton" Content="Retry saving results" Click="Retry_Click" Visibility="Collapsed"/></WrapPanel>
  <TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
  <DataGrid x:Name="Records" Height="230" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionChanged="Record_Changed" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F1" BorderBrush="#DCE3EB" Background="White" AlternatingRowBackground="#FAFBFC" HeadersVisibility="Column" RowHeight="44" ColumnHeaderHeight="40" EnableRowVirtualization="True" AutomationProperties.Name="Enrollment records">
   <DataGrid.Resources>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="#F3F6F7"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#DCE3EB"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Recorded at" Binding="{Binding ListTimeLabel}" Width="195"/>
    <DataGridTextColumn Header="User" Binding="{Binding UserLabel}" Width="180"/>
    <DataGridTextColumn Header="Tenant" Binding="{Binding TenantName}" Width="150"/>
    <DataGridTextColumn Header="Target serial" Binding="{Binding TargetSerial}" Width="110"/>
    <DataGridTemplateColumn Header="Result" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="12"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFF2E1"/><Style.Triggers><DataTrigger Binding="{Binding Outcome}" Value="Succeeded"><Setter Property="Background" Value="#EAF4D6"/></DataTrigger><DataTrigger Binding="{Binding Outcome}" Value="FailedOrInterrupted"><Setter Property="Background" Value="#FBECEE"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding OutcomeLabel}" Foreground="#263238" FontSize="12"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="SelectionDetails" TextWrapping="Wrap" Margin="0,12,0,0"/>
  <Expander Header="About these results" Margin="0,20,0,0"><TextBlock Text="Success is reported by YubiEnroll CLI, not an independent sign-in test. Reset and first-use PIN change are the configured settings. Unknown or failed attempts may still have created a credential; check Entra before retrying." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,12,0,0"/></Expander>
 </StackPanel>
 </ScrollViewer>
</UserControl>
