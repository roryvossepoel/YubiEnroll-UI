<UserControl x:Class="YubiEnroll.UI.InitialPinCell"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ContentPresenter Content="{Binding}">
  <ContentPresenter.ContentTemplate>
   <DataTemplate>
    <Grid>
      <TextBlock x:Name="Unavailable" Visibility="Collapsed" Text="{Binding PinUnavailableLabel}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
      <Grid x:Name="PinControls" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
       <Grid MaxWidth="80" Margin="0,0,4,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding PinLayoutSample}" Visibility="Hidden" TextWrapping="Wrap"/>
        <TextBlock x:Name="PinValue" Text="••••••" TextWrapping="Wrap" VerticalAlignment="Center"/>
       </Grid>
       <ToggleButton Grid.Column="1" x:Name="Reveal" Content="Show PIN" ToolTip="{Binding Content,RelativeSource={RelativeSource Self}}"
         Width="32" Height="26" VerticalAlignment="Center" Cursor="Hand" AutomationProperties.Name="{Binding Content,RelativeSource={RelativeSource Self}}"
         Checked="Pin_Checked" Unchecked="Pin_Unchecked" DataContextChanged="PinContext_Changed" Unloaded="Pin_Unloaded">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
         <Border x:Name="Chrome" Padding="4,2" BorderThickness="1" CornerRadius="5" Background="Transparent" BorderBrush="Transparent">
          <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
           <Path Stroke="{StaticResource Heading}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M1,10 Q10,-2 19,10 Q10,22 1,10 Z M12.5,10 A2.5,2.5 0 1 1 7.5,10 A2.5,2.5 0 1 1 12.5,10"/>
           <Path x:Name="Slash" Visibility="Collapsed" Stroke="{StaticResource Heading}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,2 L17,18"/>
          </Grid>
         </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E6EDF0"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Slash" Property="Visibility" Value="Visible"/><Setter TargetName="Chrome" Property="Background" Value="#E3F0F5"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Heading}"/></Trigger>
         </ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
       </ToggleButton>
      </Grid>
    </Grid>
    <DataTemplate.Triggers>
       <Trigger SourceName="Reveal" Property="IsChecked" Value="True">
        <Setter TargetName="PinValue" Property="Text" Value="{Binding GeneratedPin}"/><Setter TargetName="Reveal" Property="Content" Value="Hide PIN"/>
       </Trigger>
       <DataTrigger Binding="{Binding GeneratedPin}" Value="{x:Null}"><Setter TargetName="PinControls" Property="Visibility" Value="Collapsed"/><Setter TargetName="Unavailable" Property="Visibility" Value="Visible"/></DataTrigger>
    </DataTemplate.Triggers>
   </DataTemplate>
  </ContentPresenter.ContentTemplate>
 </ContentPresenter>
</UserControl>
