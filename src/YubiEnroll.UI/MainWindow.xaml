<Window x:Class="YubiEnroll.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="YubiEnroll UI — community preview" Width="1120" Height="850" MinWidth="900" MinHeight="700" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
   <TextBlock Text="YubiEnroll UI" FontSize="28" FontWeight="SemiBold" Foreground="#14263B"/>
   <TextBlock Text="Register a YubiKey on behalf of a Microsoft Entra ID user." Margin="0,4,0,8" Foreground="#42536A"/>
   <TextBlock x:Name="ContextBanner" Text="Load your existing YubiEnroll configuration to begin." FontWeight="SemiBold" TextWrapping="Wrap"/>
  </StackPanel>
  <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,14,0,0" Text="Starting…" TextWrapping="Wrap"/>
  <Grid x:Name="WorkPanel">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="YubiEnroll executable" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <TextBox x:Name="ExePath" Grid.Column="1" IsReadOnly="True"/>
     <Button Content="Browse…" Grid.Column="2" Click="BrowseExe_Click" Margin="8,0,0,0"/>
     <TextBlock Grid.Row="1" Text="Configuration" VerticalAlignment="Center" Margin="0,8,12,0"/>
     <TextBox x:Name="ConfigPath" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,8,0,0"/>

     <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Reload configuration" Click="Reload_Click"/>
      <Button Content="Restart as administrator" Click="Elevate_Click"/>
      <TextBlock x:Name="VersionText" VerticalAlignment="Center" TextWrapping="Wrap"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Row="1" Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0"><TextBlock Text="1 · Tenant" Margin="0,0,0,6" FontWeight="SemiBold"/>
      <ComboBox x:Name="Tenants" DisplayMemberPath="Name" SelectionChanged="Tenant_Changed"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="2 · Enrollment profile" Margin="0,0,0,6" FontWeight="SemiBold"/>
      <ComboBox x:Name="Profiles" DisplayMemberPath="Name" SelectionChanged="Profile_Changed"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
      <Button Content="Login" Click="Login_Click"/><Button Content="Status" Click="Status_Click"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="White" Padding="16" CornerRadius="8">
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="3 · Find and select a user" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Search" Click="Search_Click" Margin="8,0,0,0"/><TextBox x:Name="Query" KeyDown="Query_KeyDown"/></DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
       <TextBlock x:Name="SelectedUserText" Text="No user selected" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <TextBlock Text="Key display name (optional)"/><TextBox x:Name="KeyName" MaxLength="100" Margin="0,4,0,10"/>
       <CheckBox x:Name="ResetKey" Content="Reset key during enrollment (destructive)" Margin="0,0,0,10"/>
       <WrapPanel><Button x:Name="EnrollButton" Content="Register YubiKey" Click="Enroll_Click" IsEnabled="False"/>
        <Button x:Name="CredentialsButton" Content="List credentials" Click="Credentials_Click" IsEnabled="False"/></WrapPanel>
      </StackPanel>
      <ListBox x:Name="Users" SelectionChanged="User_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="4,6"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
    <Border Grid.Column="2" Background="White" Padding="16" CornerRadius="8">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="ProfileSummary" Text="Choose a profile." TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TabControl Grid.Row="1">
       <TabItem Header="Details"><TextBox x:Name="Details" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
       <TabItem Header="Activity"><TextBox x:Name="Activity" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
      </TabControl>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
