<Window x:Class="YubiEnroll.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="YubiEnroll UI — Community Preview" Width="1120" Height="780" MinWidth="640" MinHeight="500" Background="#F5F7FA" FontFamily="Segoe UI" FontSize="14" Foreground="#172B41" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EAF0F4" BorderBrush="#DCE3EB" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
     <TextBlock x:Name="BrandTitle" Text="YubiEnroll UI" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock x:Name="BrandSubtitle" Text="COMMUNITY PREVIEW" FontSize="10" Foreground="#617084" Margin="0,5,0,20"/>
     <Border Background="White" CornerRadius="8" Padding="12"><TextBlock x:Name="SelectedKeyCard" Text="No key selected" TextWrapping="Wrap" FontSize="12"/></Border>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click" Margin="0,0,0,8"/>
     <Button x:Name="AboutButton" Content="Help &amp; About" Click="About_Click" Margin="0"/>
    </StackPanel>
    <StackPanel x:Name="Navigation">
     <Button x:Name="OverviewButton" Content="Overview" Click="Overview_Click" Margin="0,0,0,8"/>
     <Button x:Name="PrepareButton" Content="Prepare Key" Click="Prepare_Click" Margin="0,0,0,8"/>
     <Button x:Name="KeyToolsButton" Content="Key Management" Click="KeyTools_Click" Margin="0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DCE3EB" BorderThickness="0,1,0,0" Padding="20,12">
     <DockPanel><Button Content="View details" DockPanel.Dock="Right" Click="Details_Click" Padding="12,6" Margin="12,0,0,0"/><TextBlock x:Name="StatusText" Text="Starting…" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#526277" MaxHeight="65"/></DockPanel>
    </Border>
    <Grid x:Name="WorkPanel">
     <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28">
       <TextBlock Text="Overview" FontSize="28" FontWeight="SemiBold"/>
       <TextBlock Text="Inspect your security key, then choose what to do." Foreground="#617084" Margin="0,6,0,24"/>
       <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
        <TextBlock Text="Connected key" Style="{StaticResource SectionTitle}"/>
        <ComboBox x:Name="OverviewKeys" DisplayMemberPath="Label" SelectionChanged="OverviewKey_Changed" Margin="0,14,0,12" AutomationProperties.Name="Connected security key"/>
        <TextBlock x:Name="KeyInfo" Text="Connect a YubiKey to get started." TextWrapping="Wrap" Foreground="#526277" Margin="0,0,0,14"/>
        <Button Content="Refresh keys" Click="RefreshKeys_Click" HorizontalAlignment="Left"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
        <TextBlock Text="Readiness" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="ReadinessText" Text="Checking prerequisites…" TextWrapping="Wrap" Foreground="#526277" Margin="0,10,0,14"/>
        <Button Content="Check prerequisites" Click="Prerequisites_Click" HorizontalAlignment="Left"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="What would you like to do?" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Prepare a key for a user, or erase existing FIDO credentials without signing in to a tenant." TextWrapping="Wrap" Foreground="#617084" Margin="0,10,0,16"/>
        <WrapPanel><Button Content="Prepare Key" Click="Prepare_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Key Management" Click="KeyTools_Click"/></WrapPanel>
       </StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
     <ScrollViewer x:Name="PreparePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel Margin="28">
       <TextBlock Text="Prepare Key" FontSize="28" FontWeight="SemiBold"/>
       <TextBlock Text="Connect to a tenant and prepare a key for a user." Foreground="#617084" Margin="0,6,0,24"/>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
     <StackPanel>
      <TextBlock Text="1   Connect to a tenant" Style="{StaticResource SectionTitle}"/>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="Tenants" DisplayMemberPath="Name" SelectionChanged="Tenant_Changed" VerticalContentAlignment="Center" AutomationProperties.Name="Tenant"/>
       <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" Click="Login_Click" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/>
      </Grid>
      <TextBlock x:Name="ContextBanner" Text="Select a tenant to begin." TextWrapping="Wrap" Foreground="#617084" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
    <Grid x:Name="PreparationColumns"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="UserCard" Style="{StaticResource Card}" Margin="0,0,8,0">
     <StackPanel x:Name="SearchPanel" IsEnabled="False">
      <TextBlock Text="2   Choose a user" Style="{StaticResource SectionTitle}"/>
      <DockPanel Margin="0,14,0,12"><Button DockPanel.Dock="Right" Content="Search" Click="Search_Click" Margin="12,0,0,0"/><TextBox x:Name="Query" KeyDown="Query_KeyDown" ToolTip="Search by name or username" AutomationProperties.Name="Search users"/></DockPanel>
      <ListBox x:Name="Users" SelectionChanged="User_Changed" MinHeight="150" MaxHeight="220" BorderBrush="#DCE3EB" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,7"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><TextBlock Text="{Binding Id}" Foreground="#7A8796" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      </ListBox>
      <TextBlock x:Name="SelectedUserText" Text="Connect to a tenant, then search for a user." Foreground="#617084" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
    <Border x:Name="PreparationCard" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
     <StackPanel x:Name="PreparePanel" IsEnabled="False">
      <TextBlock Text="3   Prepare the YubiKey" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Configuration profile" Margin="0,14,0,6"/>
      <ComboBox x:Name="Profiles" DisplayMemberPath="Name" SelectionChanged="Profile_Changed"/>
      <TextBlock Text="Key name (optional)" Margin="0,12,0,6"/>
      <TextBox x:Name="KeyName" MaxLength="100"/><TextBlock Text="Leave blank to use YubiEnroll’s default registration name (the key serial number)." TextWrapping="Wrap" Foreground="#617084" FontSize="12" Margin="0,6,0,0"/>
      <TextBlock x:Name="ResetNotice" TextWrapping="Wrap" Foreground="#9A4B0A" Margin="0,12,0,0"/>
      <Expander Header="Profile details" Margin="0,10,0,14"><TextBlock x:Name="ProfileSummary" TextWrapping="Wrap" Foreground="#617084" Margin="0,8,0,0"/></Expander>
      <WrapPanel><Button x:Name="EnrollButton" Content="Prepare YubiKey" Click="Enroll_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False"/><Button x:Name="CredentialsButton" Content="View registered keys" Click="Credentials_Click" IsEnabled="False"/></WrapPanel>
     </StackPanel>
    </Border>
    </Grid>

      </StackPanel>
     </ScrollViewer>
     <ContentControl x:Name="HostedPage" Visibility="Collapsed"/>
     <DockPanel x:Name="DetailsPage" Visibility="Collapsed" Margin="28">
      <TextBlock DockPanel.Dock="Top" Text="Activity &amp; diagnostics" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock DockPanel.Dock="Top" Text="Operation details appear here when available. Interactive terminal output is not recorded." TextWrapping="Wrap" Foreground="#617084" Margin="0,8,0,10"/>
      <Expander x:Name="LogExpander" IsExpanded="True" Visibility="Collapsed"/>
     <TabControl x:Name="OutputTabs"  Margin="0,12,0,0">
      <TabItem Header="Details"><Grid><TextBox x:Name="Details" IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/><TextBlock Text="No operation details available." Margin="14" Foreground="#617084" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Details}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></TabItem>
      <TabItem Header="Activity"><Grid><TextBox x:Name="Activity" IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="No activity yet." Margin="14" Foreground="#617084" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Activity}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></TabItem>
      <TabItem Header="Diagnostics"><Grid><TextBox x:Name="Diagnostics" IsReadOnly="True" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="No diagnostic details available." Margin="14" Foreground="#617084" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Diagnostics}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></TabItem>
     </TabControl>

     </DockPanel>
    </Grid>
   </DockPanel>
   <ContentControl x:Name="TerminalOverlay" Visibility="Collapsed" Background="#F5F7FA"/>
  </Grid>
 </Grid>
</Window>
