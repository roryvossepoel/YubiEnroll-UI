<Window UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" x:Class="YubiEnroll.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="pack://application:,,,/Assets/App.ico" Title="Passkey Desk for YubiKeys — Policy Preview 4" Width="1180" Height="840" MinWidth="720" MinHeight="540" Background="White" FontFamily="Segoe UI" FontSize="14" Foreground="#222B30" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Background="#F2F3F2" BorderBrush="#E5E8E5" BorderThickness="0,0,1,0"><DockPanel Margin="12,28,12,20">
  <Grid DockPanel.Dock="Top" Margin="10,0,0,34"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource BrandMark}" Width="36" Height="36" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock x:Name="BrandTitle" Text="Passkey Desk" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Heading}"/><TextBlock Text="for YubiKeys" Foreground="{StaticResource Heading}"/></StackPanel></Grid>
  <Button DockPanel.Dock="Bottom" Margin="0" x:Name="SettingsButton" Style="{StaticResource NavigationButton}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource SettingsGlyph}" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
  <StackPanel x:Name="Navigation">
   <StackPanel.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource NavigationButton}">
     <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
   </StackPanel.Resources>
   <Button x:Name="OverviewButton" Click="Overview_Click"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource HomeGlyph}" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock Text="Home" VerticalAlignment="Center"/></StackPanel></Button>
   <Button x:Name="PrepareButton" Click="Prepare_Click"><DockPanel><Image DockPanel.Dock="Left" Source="{StaticResource EnrollGlyph}" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock TextWrapping="Wrap" Text="Set up a YubiKey" VerticalAlignment="Center"/></DockPanel></Button>
<Button x:Name="BulkNav" Click="BatchOpen_Click"><DockPanel><Image DockPanel.Dock="Left" Source="{StaticResource BulkGlyph}" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock TextWrapping="Wrap" Text="Set up multiple YubiKeys" VerticalAlignment="Center"/></DockPanel></Button>
   <Button x:Name="AddPasskeyButton" Click="AddPasskey_Click"><DockPanel><Image DockPanel.Dock="Left" Source="{StaticResource PasskeyGlyph}" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock TextWrapping="Wrap" Text="Add a passkey" VerticalAlignment="Center"/></DockPanel></Button>
   <Button x:Name="LocalButton" Click="Local_Click"><DockPanel><Image DockPanel.Dock="Left" Source="{StaticResource LocalGlyph}" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock TextWrapping="Wrap" Text="Passkeys on a YubiKey" VerticalAlignment="Center"/></DockPanel></Button>
   <Button x:Name="ManageButton" Click="Manage_Click"><DockPanel><Image DockPanel.Dock="Left" Source="{StaticResource ManageGlyph}" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock TextWrapping="Wrap" Text="Manage user passkeys" VerticalAlignment="Center"/></DockPanel></Button>
   <Button x:Name="ResetButton" Click="ResetPage_Click"><DockPanel><Image DockPanel.Dock="Left" Source="{StaticResource ResetGlyph}" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock TextWrapping="Wrap" Text="Clear passkeys &amp; PIN" VerticalAlignment="Center"/></DockPanel></Button>
  </StackPanel>
 </DockPanel></Border>
 <Grid Grid.Column="1"><DockPanel>
  <Border x:Name="StatusBar" DockPanel.Dock="Bottom" BorderBrush="#E5E8E5" BorderThickness="0,1,0,0" Padding="28,10" Visibility="Collapsed"><TextBlock x:Name="StatusText" Text="Starting…" TextWrapping="Wrap" Foreground="#52606B" MaxHeight="70"/></Border>
  <Grid x:Name="WorkPanel">
   <DockPanel x:Name="StartupPage" Visibility="Collapsed"><Border DockPanel.Dock="Bottom" Padding="28,16" BorderBrush="#DDE2E4" BorderThickness="0,1,0,0"><Grid><Button x:Name="StartupRequirements" Content="Open prerequisites" Click="Prerequisites_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0"/><Button x:Name="StartupElevate" Content="Restart as administrator" Click="Elevate_Click" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" HorizontalAlignment="Right" Margin="0"/></Grid></Border><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="44,48,44,32" MaxWidth="760">
    <TextBlock Text="Before you start" Style="{StaticResource PageTitle}"/>
    <TextBlock x:Name="StartupSummary" Text="Checking administrator access and required software…" Foreground="{StaticResource Muted}" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,28"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="Administrator access" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="StartupAdminStatus" Text="Checking…" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <Border Height="1" Background="#E5E8E5" Margin="0,20"/>
     <TextBlock Text="YubiEnroll CLI" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="StartupEnrollStatus" Text="Checking…" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <Border x:Name="StartupPolicyStep" Visibility="Collapsed" BorderBrush="#CDDADD" BorderThickness="2,0,0,0" Margin="8,12,0,0" Padding="12,0,0,0">
      <StackPanel><TextBlock Text="Organization policy" FontWeight="SemiBold"/><TextBlock x:Name="StartupPolicyStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,3,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
     </Border>
     <Border Height="1" Background="#E5E8E5" Margin="0,20"/>
     <TextBlock Text="YubiKey Manager CLI (ykman)" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="StartupManagerStatus" Text="Checking…" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,18,0,0"><Run x:Name="StartupFeedback"/><Run Text="Requirements are checked automatically when you return to this window."/></TextBlock>
    </StackPanel></ScrollViewer></DockPanel>
   <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HomeBody" Margin="44,64,44,32" MaxWidth="900" HorizontalAlignment="Stretch">
    <TextBlock Text="What would you like to do?" Style="{StaticResource PageTitle}"/><TextBlock Text="Set up a YubiKey or manage passkeys." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="16" Margin="0,12,0,36"/>
    <UniformGrid x:Name="HomeTasks" Columns="2"><Button x:Name="HomeSetupCard" Click="Prepare_Click" Style="{StaticResource TaskCard}"><Grid x:Name="HomeSetupLayout"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="HomeSetupIcon" Background="#F1F7E3" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,20"><Image Source="{StaticResource EnrollGlyph}" Width="30" Height="30"/></Border>
<StackPanel x:Name="HomeSetupText" Grid.Row="1"><TextBlock Text="Set up a YubiKey" TextWrapping="Wrap" Foreground="{StaticResource Heading}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Set up a YubiKey and register it for a user." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,3,0,0"/></StackPanel>
</Grid></Button><Button x:Name="HomeBulkCard" Click="BatchOpen_Click" Style="{StaticResource TaskCard}"><Grid x:Name="HomeBulkLayout"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="HomeBulkIcon" Background="#F1F7E3" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,20"><Image Source="{StaticResource BulkGlyph}" Width="30" Height="30"/></Border>
<StackPanel x:Name="HomeBulkText" Grid.Row="1"><TextBlock Text="Set up multiple YubiKeys" TextWrapping="Wrap" Foreground="{StaticResource Heading}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Set up one YubiKey per user from a list." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,3,0,0"/></StackPanel>
</Grid></Button></UniformGrid><TextBlock Text="Manage passkeys" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/><Button x:Name="HomeAdditionCard" Click="AddPasskey_Click" Style="{StaticResource TaskCard}"><Grid x:Name="HomeAdditionLayout"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="HomeAdditionIcon" Background="#F1F7E3" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,20"><Image Source="{StaticResource PasskeyGlyph}" Width="30" Height="30"/></Border>
<StackPanel x:Name="HomeAdditionText" Grid.Row="1"><TextBlock Text="Add a passkey" TextWrapping="Wrap" Foreground="{StaticResource Heading}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Add a passkey to an existing YubiKey. Keep its other passkeys and PIN." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,3,0,0"/></StackPanel>
</Grid></Button><Button x:Name="HomeLocalCard" Click="Local_Click" Style="{StaticResource TaskCard}"><Grid x:Name="HomeLocalLayout"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="HomeLocalIcon" Background="#F1F7E3" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,20"><Image Source="{StaticResource LocalGlyph}" Width="30" Height="30"/></Border>
<StackPanel x:Name="HomeLocalText" Grid.Row="1"><TextBlock Text="Passkeys on a YubiKey" TextWrapping="Wrap" Foreground="{StaticResource Heading}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="View stored passkeys or remove one from a connected YubiKey." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,3,0,0"/></StackPanel>
</Grid></Button><Button x:Name="HomeManageCard" Click="Manage_Click" Style="{StaticResource TaskCard}"><Grid x:Name="HomeManageLayout"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="HomeManageIcon" Background="#F1F7E3" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,20"><Image Source="{StaticResource ManageGlyph}" Width="30" Height="30"/></Border>
<StackPanel x:Name="HomeManageText" Grid.Row="1"><TextBlock Text="Manage user passkeys" TextWrapping="Wrap" Foreground="{StaticResource Heading}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="View or remove a user’s YubiKey registrations in Microsoft Entra." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,3,0,0"/></StackPanel>
</Grid></Button><TextBlock Text="Reset FIDO on a YubiKey" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/><Button x:Name="HomeResetCard" Click="ResetPage_Click" Style="{StaticResource TaskCard}"><Grid x:Name="HomeResetLayout"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="HomeResetIcon" Background="#F1F7E3" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,20"><Image Source="{StaticResource ResetGlyph}" Width="30" Height="30"/></Border>
<StackPanel x:Name="HomeResetText" Grid.Row="1"><TextBlock Text="Clear passkeys &amp; PIN" TextWrapping="Wrap" Foreground="{StaticResource Heading}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Clears all passkeys and the FIDO PIN on this YubiKey. Registrations in Entra are kept." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,3,0,0"/></StackPanel>
</Grid></Button>
    <TextBlock Text="Your key is only changed after you review and confirm." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,20,0,0"/>
   </StackPanel></ScrollViewer>
   <DockPanel x:Name="PreparePage" Visibility="Collapsed">
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDE2E4" BorderThickness="0,1,0,0" Padding="28,16"><StackPanel><TextBlock x:Name="FooterInstruction" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"/><DockPanel><Button x:Name="EnrollNext" DockPanel.Dock="Right" Content="Continue to tenant" Click="EnrollNext_Click" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"/><Button x:Name="EnrollButton" DockPanel.Dock="Right" Content="Start enrollment" Click="Enroll_Click" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" IsEnabled="False"/><Button x:Name="EnrollBack" Content="Back to Home" Click="EnrollBack_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/></DockPanel></StackPanel></Border>
    <DockPanel Style="{StaticResource WizardFrame}"><StackPanel DockPanel.Dock="Top">
     <Grid x:Name="EnrollProgress" Style="{StaticResource WizardSteps}"/>
     <TextBlock x:Name="EnrollmentTaskLabel" Text="SET UP A YUBIKEY" Style="{StaticResource WizardEyebrow}"/><TextBlock x:Name="EnrollHeading" Style="{StaticResource PageTitle}"/><TextBlock x:Name="EnrollDescription" Style="{StaticResource WizardIntro}"/></StackPanel><ScrollViewer x:Name="EnrollmentScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,24">

     <TextBlock x:Name="FooterTargetText" Foreground="{StaticResource Heading}" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <StackPanel x:Name="EnrollmentChooser"><DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="EnrollmentInventoryProgress" Text="Checking connected keys…" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/><Button Content="Refresh" ContentTemplate="{StaticResource RefreshContent}" Style="{StaticResource QuietButton}" Click="RefreshKeys_Click"/></StackPanel><TextBlock Text="Connected keys" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
 <StackPanel x:Name="EnrollmentReaderStatus" Visibility="Collapsed"/>
 <ContentControl x:Name="EnrollmentKeysPlaceholder" Template="{StaticResource EmptyKeyTemplate}" Focusable="False" IsHitTestVisible="False" Tag="Checking for YubiKeys…" AutomationProperties.LiveSetting="Polite"/>
      <ListBox x:Name="EnrollmentKeys" Background="Transparent" BorderThickness="0" MaxHeight="270" ItemTemplate="{StaticResource KeyChoiceTemplate}" ItemContainerStyle="{StaticResource KeyChoice}" SelectionChanged="OverviewKey_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Choose target key"/>
      <TextBlock x:Name="KeyInfo" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
     </StackPanel>
     <StackPanel x:Name="TenantStep" Visibility="Collapsed">
      <TextBlock Text="Tenant" Margin="0,12,0,8"/>
      <Grid x:Name="TenantConnectionRow"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="Tenants" DisplayMemberPath="Name" SelectionChanged="Tenant_Changed" AutomationProperties.Name="Tenant"/>
       <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" Click="Login_Click" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/>
      </Grid>
      <TextBlock x:Name="EmptyTenants" Text="Add your first tenant in Settings → Tenants." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
      <TextBlock x:Name="ContextBanner" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="EnrollmentTargetNotice" TextWrapping="Wrap" Margin="0,20,0,0" Foreground="{StaticResource Muted}"/>
     </StackPanel>
     <StackPanel x:Name="UserCard" Visibility="Collapsed"><StackPanel x:Name="SearchPanel" IsEnabled="False"><TextBlock Text="Search by name or email" Margin="0,12,0,8"/><DockPanel><Button Content="Search" DockPanel.Dock="Right" Click="Search_Click" Margin="12,0,0,0"/><TextBox x:Name="Query" KeyDown="Query_KeyDown" AutomationProperties.Name="Search users"/></DockPanel><DataGrid x:Name="Users" SelectionChanged="User_Changed" Margin="0,16,0,0" MinHeight="100" MaxHeight="360"
        AutomationProperties.Name="User search results" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
        SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
        HorizontalGridLinesBrush="#EDF0F1" Background="White" AlternatingRowBackground="#F6F8F9" BorderBrush="#DCE3EB">
        <DataGrid.Resources>
         <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F3F6F7"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
         <Style x:Key="UserCellText" TargetType="TextBlock"><Setter Property="Margin" Value="10,7"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        </DataGrid.Resources>
        <DataGrid.Columns>
         <DataGridTextColumn Header="Display name" Binding="{Binding SearchResultName}" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource UserCellText}"/>
         <DataGridTextColumn Header="Sign-in name (UPN)" Binding="{Binding UserPrincipalName}" Width="1.8*" MinWidth="170" ElementStyle="{StaticResource UserCellText}"/>
         <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.3*" MinWidth="130" ElementStyle="{StaticResource UserCellText}"/>
        </DataGrid.Columns>
       </DataGrid><TextBlock x:Name="SelectedUserText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></StackPanel>
     <StackPanel x:Name="ProfileStep" Visibility="Collapsed"><StackPanel x:Name="PreparePanel" IsEnabled="False">
      <TextBlock Text="Configuration profile" Style="{StaticResource SectionTitle}" Margin="0,8,0,12"/>
      <ListBox x:Name="Profiles" SelectionChanged="Profile_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="300">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12,10"><TextBlock Text="{Binding Profile.Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsEnabled" Value="{Binding Compatible}"/><Setter Property="Margin" Value="0,0,0,8"/></Style></ListBox.ItemContainerStyle>
      </ListBox>
      <TextBlock x:Name="ProfileCompatibilityText" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel></StackPanel>
     <StackPanel x:Name="NamePanel" Visibility="Collapsed" Margin="0,20,0,12"><TextBlock Text="Registration name" Margin="0,0,0,8"/><TextBox x:Name="KeyName" MaxLength="100"/></StackPanel>
     <StackPanel x:Name="PreparationCard" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel x:Name="ReviewSummary"/></Border>
      <TextBlock x:Name="ReviewRecipient" Visibility="Collapsed"/>
      <Border x:Name="ReviewWarningBox" Background="#FFF4ED" CornerRadius="8" Padding="16" Margin="0,20,0,0"><TextBlock x:Name="ReviewWarning" TextWrapping="Wrap" Foreground="#854018"/></Border>
      <TextBlock x:Name="RegistrationReviewNote" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,16,0,0" FontSize="12"/>
      <TextBlock x:Name="ReviewTargetNotice" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#854018"/>
     </StackPanel>
     <StackPanel x:Name="EnrollmentResult" Visibility="Collapsed"><TextBlock x:Name="EnrollmentResultText" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,16"/><TextBlock x:Name="RegistrationLogStatus" TextWrapping="Wrap" Margin="0,0,0,12"/><Button x:Name="RetryRegistrationLog" Content="Retry saving registration log" Click="RetryRegistrationLog_Click" HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="Collapsed"/></StackPanel>
    </StackPanel></ScrollViewer></DockPanel>
   </DockPanel>
   <DockPanel x:Name="BatchPage" Visibility="Collapsed"><Border DockPanel.Dock="Bottom" Padding="28,16" BorderBrush="#DDE2E4" BorderThickness="0,1,0,0"><DockPanel><Button x:Name="BatchToProfile" DockPanel.Dock="Right" Content="Continue to profile" Click="BatchToProfile_Click" Style="{StaticResource PrimaryButton}" ContentTemplate="{StaticResource ForwardContent}"/><Button DockPanel.Dock="Right" ContentTemplate="{StaticResource ForwardContent}" x:Name="BatchToUsers" Content="Continue to users" Click="BatchToUsers_Click" Style="{StaticResource PrimaryButton}"/><Button DockPanel.Dock="Right" ContentTemplate="{StaticResource ForwardContent}" x:Name="BatchCheck" Content="Check users" Click="BatchValidate_Click" Style="{StaticResource PrimaryButton}"/><Button DockPanel.Dock="Right" ContentTemplate="{StaticResource ForwardContent}" x:Name="BatchStart" Content="Start batch" Click="BatchStart_Click" Style="{StaticResource PrimaryButton}"/><Button DockPanel.Dock="Right" x:Name="BatchFinish" Content="End batch early…" Click="BatchFinish_Click" Style="{StaticResource QuietButton}" Visibility="Collapsed"/><Button HorizontalAlignment="Left" x:Name="BatchBack" Content="Back" Click="BatchBack_Click" Style="{StaticResource QuietButton}"/></DockPanel></Border><DockPanel Style="{StaticResource WizardFrame}"><StackPanel DockPanel.Dock="Top">
    <Grid x:Name="BatchProgress" Style="{StaticResource WizardSteps}"/>
    <TextBlock Text="SET UP MULTIPLE YUBIKEYS" Style="{StaticResource WizardEyebrow}"/><TextBlock x:Name="BatchTitle" Style="{StaticResource PageTitle}"/>
    <TextBlock x:Name="BatchContext" Style="{StaticResource WizardIntro}"/></StackPanel><ScrollViewer x:Name="BatchScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,24">
    <StackPanel x:Name="BatchSetup">
     <DockPanel><Button x:Name="BatchConnect" DockPanel.Dock="Right" Content="Connect" Click="BatchConnect_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/><Grid><ComboBox IsSynchronizedWithCurrentItem="False" x:Name="BatchTenant" DisplayMemberPath="Name" SelectionChanged="BatchTenant_Changed" AutomationProperties.Name="Batch tenant"/><TextBlock Text="Select a tenant..." IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,28,0" Foreground="{StaticResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=BatchTenant}" Value="-1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
     <TextBlock x:Name="BatchConnection" Foreground="{StaticResource Muted}" Margin="0,6,0,16"/>
     </StackPanel><StackPanel x:Name="BatchProfileStep" Visibility="Collapsed"><TextBlock Text="Configuration profile" Margin="0,0,0,5"/><ComboBox x:Name="BatchProfile" DisplayMemberPath="Name" SelectionChanged="BatchProfile_Changed" AutomationProperties.Name="Batch profile"/>
     <TextBlock x:Name="BatchPolicy" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>

    </StackPanel>
    <StackPanel x:Name="BatchInput" Visibility="Collapsed">
     <TextBlock Text="User principal names" Style="{StaticResource SectionTitle}"/>
     <TextBlock Text="Paste one sign-in name per line, or import a CSV with a UserPrincipalName column." TextWrapping="Wrap" Margin="0,8,0,10"/>
     <TextBox x:Name="BatchText" AcceptsReturn="True" Height="140" MaxLength="256000" VerticalScrollBarVisibility="Auto" TextChanged="BatchText_Changed" AutomationProperties.Name="User principal names"/>
     <WrapPanel Margin="0,12,0,0"><Button Content="Import CSV…" Click="BatchImport_Click"/></WrapPanel>
     <TextBlock x:Name="BatchProblems" Foreground="#854018" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
    <StackPanel x:Name="BatchReview" Visibility="Collapsed">
     <TextBlock Text="Review the recipients" Style="{StaticResource SectionTitle}"/>
     <TextBlock x:Name="BatchReviewCount" Margin="0,8,0,12" TextWrapping="Wrap"/>
     <ListBox x:Name="BatchReviewUsers" MaxHeight="270" AutomationProperties.Name="Verified batch recipients"><ListBox.ItemTemplate><DataTemplate><TextBlock Margin="8,4"><Run Text="{Binding DisplayName, Mode=OneWay}"/> · <Run Text="{Binding UserPrincipalName, Mode=OneWay}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox>

    </StackPanel>
    <StackPanel x:Name="BatchIssue" Visibility="Collapsed">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="BatchNumber" Foreground="{StaticResource Muted}"/><TextBlock x:Name="BatchRecipient" Style="{StaticResource SectionTitle}" Margin="0,6,0,2"/><TextBlock x:Name="BatchUpn" TextWrapping="Wrap"/></StackPanel></Border>
     <Button x:Name="BatchResumeConnect" Content="Reconnect to batch tenant" Click="BatchConnect_Click" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,10,0,0"/>
     <StackPanel x:Name="BatchChoose">
      <DockPanel Margin="0,16,0,8"><Button Content="Refresh" DockPanel.Dock="Right" Click="RefreshKeys_Click" ContentTemplate="{StaticResource RefreshContent}" Style="{StaticResource QuietButton}"/><TextBlock Text="Choose a new YubiKey" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
      <StackPanel x:Name="BatchReaderStatus" Visibility="Collapsed"/><ContentControl x:Name="BatchKeysPlaceholder" Template="{StaticResource EmptyKeyTemplate}" Focusable="False" IsHitTestVisible="False" Tag="Checking for YubiKeys…" AutomationProperties.LiveSetting="Polite"/>
      <ListBox x:Name="BatchKeys" ItemTemplate="{StaticResource KeyChoiceTemplate}" ItemContainerStyle="{StaticResource KeyChoice}" SelectionChanged="BatchKey_Changed" BorderThickness="0" MaxHeight="220" AutomationProperties.Name="Batch target key"/>
      <TextBlock x:Name="BatchKeyHint" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{StaticResource Muted}"/>
      <WrapPanel><Button x:Name="BatchRegister" Content="Register YubiKey" Click="BatchRegister_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Skip user" Click="BatchSkip_Click" Style="{StaticResource QuietButton}"/></WrapPanel>
     </StackPanel>
     <StackPanel x:Name="BatchHandoff" Visibility="Collapsed" Margin="0,16,0,0">
      <TextBlock x:Name="BatchOutcome" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="BatchInstructions" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <Button x:Name="BatchNext" Content="Next user" Click="BatchNext_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
     </StackPanel>
     <TextBlock x:Name="BatchLogNotice" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource Muted}"/>
     <Button x:Name="BatchRetryLog" Content="Retry saving registration log" Click="BatchRetryLog_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel x:Name="BatchResults" Visibility="Collapsed">
     <TextBlock Text="Batch results" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="BatchTotals" TextWrapping="Wrap" Margin="0,8,0,12"/>
     <DataGrid x:Name="BatchRows" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="320" AutomationProperties.Name="Issuance results"><DataGrid.Columns>
      <DataGridTextColumn Header="User principal name" Binding="{Binding User.UserPrincipalName}" Width="*"/><DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="110"/><DataGridTextColumn Header="Result" Binding="{Binding StatusLabel}" Width="135"/>
     </DataGrid.Columns></DataGrid>
     <WrapPanel Margin="0,16,0,0"><Button Content="Export CSV…" Click="BatchExport_Click" Style="{StaticResource PrimaryButton}"/><Button Content="New batch" Click="BatchNew_Click"/></WrapPanel>
    </StackPanel>

   </StackPanel></ScrollViewer></DockPanel></DockPanel>
   <DockPanel x:Name="ResetPage" Visibility="Collapsed">
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDE2E4" BorderThickness="0,1,0,0" Padding="28,16"><DockPanel><Button x:Name="ResetNext" DockPanel.Dock="Right" Content="Review reset" Click="ResetNext_Click" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"/><Button x:Name="ResetTargetButton" DockPanel.Dock="Right" Content="Erase FIDO passkeys and PIN" Click="ResetTarget_Click" Style="{StaticResource DangerButton}" Visibility="Collapsed" IsEnabled="False"/><Button x:Name="ResetBack" Content="Back to Home" Click="ResetBack_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/></DockPanel></Border>
    <DockPanel Style="{StaticResource WizardFrame}"><StackPanel DockPanel.Dock="Top"><Grid x:Name="ResetProgress" Style="{StaticResource WizardSteps}"/><TextBlock Text="CLEAR PASSKEYS &amp; PIN" Style="{StaticResource WizardEyebrow}"/><TextBlock x:Name="ResetHeading" Style="{StaticResource PageTitle}"/><TextBlock x:Name="ResetDescription" Style="{StaticResource WizardIntro}"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,24">
    <StackPanel x:Name="OverviewChooser"><DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="ResetInventoryProgress" Text="Checking connected keys…" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/><Button Content="Refresh" ContentTemplate="{StaticResource RefreshContent}" Style="{StaticResource QuietButton}" Click="RefreshKeys_Click"/></StackPanel><TextBlock Text="Connected keys" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
 <StackPanel x:Name="ResetReaderStatus" Visibility="Collapsed"/>
 <ContentControl x:Name="OverviewKeysPlaceholder" Template="{StaticResource EmptyKeyTemplate}" Focusable="False" IsHitTestVisible="False" Tag="Checking for YubiKeys…" AutomationProperties.LiveSetting="Polite"/>
      <ListBox x:Name="OverviewKeys" Background="Transparent" BorderThickness="0" MaxHeight="270" ItemTemplate="{StaticResource KeyChoiceTemplate}" ItemContainerStyle="{StaticResource KeyChoice}" SelectionChanged="OverviewKey_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Choose target key"/>
     <TextBlock x:Name="ResetInventoryInfo" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><Border Background="#F2F4F4" CornerRadius="8" Padding="16" Margin="0,20,0,16"><TextBlock Text="This cannot be undone. You’ll review the selected YubiKey before confirming the reset." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></Border>
    </StackPanel>
    <StackPanel x:Name="ResetReview" Visibility="Collapsed"><TextBlock x:Name="ResetTargetText" Foreground="{StaticResource Heading}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,12"/><TextBlock x:Name="KeyPinStatus" TextWrapping="Wrap" Margin="0,0,0,18"/><Border Background="#FFF2F0" BorderBrush="#F1C5C0" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="This cannot be undone" Foreground="#A21C2B" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="All FIDO2/U2F credentials and the FIDO PIN on this key will be erased. Existing sign-ins using those credentials will stop working." TextWrapping="Wrap" Margin="0,10,0,12"/><TextBlock Text="Entra and other service registrations remain. PIV, OATH, OpenPGP and OTP are unchanged." TextWrapping="Wrap"/></StackPanel></Border><TextBlock x:Name="ResetConnectionHelp" Text="Follow the native prompts to unplug, reinsert and touch this same key." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,20,0,16"/><CheckBox x:Name="ResetAcknowledged" Checked="ResetAcknowledged_Changed" Unchecked="ResetAcknowledged_Changed"><TextBlock Text="I understand that the FIDO credentials and PIN will be erased." TextWrapping="Wrap"/></CheckBox><TextBlock x:Name="ResetAvailability" TextWrapping="Wrap" Foreground="#854018" Margin="0,14,0,0"/></StackPanel>
    <StackPanel x:Name="ResetResult" Visibility="Collapsed"><TextBlock x:Name="ResetResultText" TextWrapping="Wrap" FontSize="16"/><Button Content="Refresh key status" ContentTemplate="{StaticResource RefreshContent}" Click="RefreshKeys_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel>
    </StackPanel></ScrollViewer></DockPanel>
   </DockPanel>
   <DockPanel x:Name="LocalPage" Visibility="Collapsed">
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDE2E4" BorderThickness="0,1,0,0" Padding="28,16"><DockPanel>
     <Button x:Name="LocalView" DockPanel.Dock="Right" Content="Continue to unlock" Click="LocalView_Click" ContentTemplate="{StaticResource ForwardContent}" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"/>
     <Button x:Name="LocalBack" Content="Back to Home" Click="LocalBack_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
    </DockPanel></Border>
    <DockPanel Style="{StaticResource WizardFrame}">
    <StackPanel DockPanel.Dock="Top">
     <Grid x:Name="LocalProgress" Style="{StaticResource WizardSteps}"/>
     <TextBlock Text="PASSKEYS ON A YUBIKEY" Style="{StaticResource WizardEyebrow}"/>
     <TextBlock x:Name="LocalTitle" Style="{StaticResource PageTitle}"/>
     <TextBlock x:Name="LocalIntro" Style="{StaticResource WizardIntro}"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,24"><StackPanel x:Name="LocalChooser">
      <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshKeys_Click" Style="{StaticResource QuietButton}" ContentTemplate="{StaticResource RefreshContent}"/><TextBlock Text="Connected keys" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
      <StackPanel x:Name="LocalReaderStatus" Visibility="Collapsed"/>
      <ContentControl x:Name="LocalKeysPlaceholder" Template="{StaticResource EmptyKeyTemplate}" Focusable="False" IsHitTestVisible="False" Tag="Checking for YubiKeys…" AutomationProperties.LiveSetting="Polite"/>
      <ListBox x:Name="LocalKeys" AutomationProperties.Name="Choose a YubiKey to inspect" Margin="0,10,0,12" Background="Transparent" BorderThickness="0" SelectionChanged="LocalSelection_Changed">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource KeyChoice}"><Style.Triggers><DataTrigger Binding="{Binding ListingUnsupported}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource KeyChoiceTemplate}"/><TextBlock x:Name="Unsupported" Margin="48,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" Text="Not supported: this YubiKey cannot list stored passkeys." /></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding ListingUnsupported}" Value="True"><Setter TargetName="Unsupported" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="LocalInventoryHint" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
     </StackPanel>

     <StackPanel x:Name="LocalUnlock" Visibility="Collapsed">
      <TextBlock Text="FIDO PIN for this YubiKey" Margin="0,8,0,5"/>
      <PasswordBox x:Name="LocalPin" MaxLength="63" PasswordChanged="LocalPin_Changed" KeyDown="LocalPin_KeyDown" Padding="8" AutomationProperties.Name="FIDO PIN for this YubiKey"/>
     </StackPanel>
     <StackPanel x:Name="LocalList" Visibility="Collapsed">
      <DockPanel><Button DockPanel.Dock="Right" Content="Remove passkey…" Click="LocalRemove_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DangerButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=LocalRows}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="Stored passkeys" Style="{StaticResource SectionTitle}"/></DockPanel>
      <ListBox x:Name="LocalRows" AutomationProperties.Name="Stored passkeys" SelectionMode="Single" IsSynchronizedWithCurrentItem="False" BorderThickness="0" Padding="0" Margin="0,8,0,0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource KeyChoice}"><ListBox.ItemTemplate><DataTemplate>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{StaticResource ManageGlyph}" Width="27" Height="27" HorizontalAlignment="Left" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Foreground="{StaticResource Heading}" Text="{Binding Account}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Service}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
         <Border HorizontalAlignment="Left" Background="#EDF2F3" Padding="9,3" CornerRadius="12" Margin="0,6,0,0"><TextBlock FontSize="12" Foreground="{StaticResource Heading}" TextWrapping="Wrap"><Run Text="Credential ID · "/><Run Text="{Binding Id, Mode=OneWay}"/></TextBlock></Border>
        </StackPanel></Grid>
      </DataTemplate></ListBox.ItemTemplate></ListBox>
     </StackPanel>
     <TextBlock x:Name="LocalFeedback" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource Muted}"/>
    </StackPanel></ScrollViewer>
    </DockPanel>
   </DockPanel>
   <DockPanel x:Name="ManagePage" Visibility="Collapsed"><Border DockPanel.Dock="Bottom" Padding="28,16" BorderBrush="#DDE2E4" BorderThickness="0,1,0,0"><DockPanel><Button x:Name="ManageContinue" IsEnabled="False" DockPanel.Dock="Right" Content="Search users" ContentTemplate="{StaticResource ForwardContent}" Click="ManageContinue_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="ManageView" Content="View passkeys" Click="ManageView_Click" ContentTemplate="{StaticResource ForwardContent}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"/><Button x:Name="ManageBack" Content="Back to Home" Click="ManageBack_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0"/></DockPanel></Border><DockPanel Style="{StaticResource WizardFrame}"><StackPanel DockPanel.Dock="Top">
     <Grid x:Name="ManageProgress" Style="{StaticResource WizardSteps}"/>
     <TextBlock Text="MANAGE USER PASSKEYS" Style="{StaticResource WizardEyebrow}"/><TextBlock x:Name="ManageTitle" Text="Choose a tenant" Style="{StaticResource PageTitle}"/>
     <TextBlock x:Name="ManageContext" Style="{StaticResource WizardIntro}"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,24">
     <StackPanel x:Name="ManageTenantStep">
      <TextBlock Text="Tenant" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="ManageTenants" ItemsSource="{Binding ItemsSource, ElementName=Tenants}" IsSynchronizedWithCurrentItem="False" SelectionChanged="ManageTenant_Changed" DisplayMemberPath="Name" AutomationProperties.Name="Management tenant"/>
       <TextBlock Text="Select a tenant..." IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,28,0" Foreground="{StaticResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ManageTenants}" Value="-1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Button x:Name="ManageConnect" IsEnabled="False" Grid.Column="1" Margin="12,0,0,0" Content="Connect" Click="ManageConnect_Click" Style="{StaticResource PrimaryButton}"/></Grid>
      <TextBlock x:Name="ManageTenantHint" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
     <StackPanel x:Name="ManageUserStep" Visibility="Collapsed">
      <TextBlock Text="Search by name or email" Margin="0,0,0,6"/>
      <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Search" Click="ManageSearch_Click" Margin="12,0,0,0"/><TextBox x:Name="ManageQuery" KeyDown="ManageQuery_KeyDown" TextChanged="ManageQuery_Changed" AutomationProperties.Name="Find user"/></DockPanel>
      <ListBox x:Name="ManageUsers" DisplayMemberPath="Label" AutomationProperties.Name="User search results" SelectionChanged="ManageUser_Changed" MaxHeight="240" Margin="0,6,0,8">
       <ListBox.Style><Style TargetType="ListBox"><Style.Triggers>
        <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
       </Style.Triggers></Style></ListBox.Style>
      </ListBox>
      <TextBlock x:Name="ManageSearchHint" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>

     </StackPanel>
     <StackPanel x:Name="ManageListStep" Visibility="Collapsed">
      <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="ManageView_Click" Style="{StaticResource QuietButton}" ContentTemplate="{StaticResource RefreshContent}"/><TextBlock Text="YubiKey registrations" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
      <TextBlock x:Name="ManageFeedback" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <ItemsControl x:Name="ManageRows"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Style="{StaticResource Card}" Margin="0,0,0,10"><DockPanel>
        <Button Click="ManageRemove_Click" Foreground="#A21C2B" BorderBrush="#A21C2B" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0"
                AutomationProperties.Name="{Binding Name, StringFormat='Remove {0} from Entra'}" ToolTip="Remove this registration from Microsoft Entra">
         <TextBlock Text="Remove" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Model}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding DateLine}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
         <Expander Header="Registration ID" Margin="0,8,0,0"><TextBox Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/></Expander>
        </StackPanel></DockPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>

    </StackPanel>
   </ScrollViewer></DockPanel></DockPanel>
   <ContentControl x:Name="HostedPage" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
  </Grid>
 </DockPanel><ContentControl x:Name="TerminalOverlay" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" Background="White"/></Grid>
 </Grid>
</Window>
