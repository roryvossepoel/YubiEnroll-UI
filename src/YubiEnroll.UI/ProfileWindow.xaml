<Window Icon="pack://application:,,,/Assets/App.ico" x:Class="YubiEnroll.UI.ProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Configuration profile" Width="710" Height="780" MinWidth="540" MinHeight="400" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" FontSize="14">
 <DockPanel Margin="24">
  <TextBlock x:Name="Heading" DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <TextBlock x:Name="ValidationText" Foreground="#A4262C" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button Content="Save profile" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
   <TextBlock Text="Profile name"/><TextBox x:Name="ProfileName" MaxLength="80" Margin="0,4,0,8"/>
   <TextBlock x:Name="UsageText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
   <DockPanel><TextBlock x:Name="CustomPreset" DockPanel.Dock="Right" Text="Custom" Foreground="{StaticResource Heading}" FontWeight="SemiBold"/><TextBlock Text="Setup preset" Style="{StaticResource SectionTitle}"/></DockPanel>
   <Grid Margin="0,8,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,5,0"><RadioButton x:Name="BasicPreset" GroupName="SetupPreset" Click="Basic_Click"><StackPanel><TextBlock Text="PIN change optional" FontWeight="SemiBold"/><TextBlock Text="Generates a 6-character initial PIN. The user can keep it or change it." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></RadioButton></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="5,0,0,0"><RadioButton x:Name="ManagedPreset" GroupName="SetupPreset" Click="Managed_Click"><StackPanel><TextBlock Text="PIN change required" FontWeight="SemiBold"/><TextBlock Text="Generates a 6-character initial PIN. The user must change it at first use. Minimum length: 6." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></RadioButton></Border>
   </Grid>
   <TextBlock Text="PIN settings" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
   <CheckBox x:Name="RandomPin" Content="Generate a random initial PIN" Margin="0,4"/>
   <StackPanel x:Name="InitialLengthRow" Margin="20,3,0,8"><TextBlock Text="Initial PIN length"/><TextBox x:Name="GeneratedPinLength" Width="100" MaxLength="2" HorizontalAlignment="Left" AutomationProperties.Name="Initial PIN length"/></StackPanel>
   <CheckBox x:Name="ForcePinChange" Content="Require PIN change at first use" Margin="0,4"/>
   <TextBlock Text="Minimum PIN length" Margin="0,8,0,3"/><DockPanel><TextBox x:Name="MinimumPinLength" DockPanel.Dock="Left" Width="100" MaxLength="2" AutomationProperties.Name="Minimum PIN length"/><TextBlock Text="4–63 characters. Leave empty for no override." VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></DockPanel>
   <Expander x:Name="Advanced" Header="Advanced settings" Margin="0,16,0,8"><StackPanel Margin="8,6,0,0">
    <CheckBox x:Name="AlwaysUv" Content="Always require FIDO user verification"/>
    <TextBlock Text="Also require verification when the service doesn’t request it." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="20,3,0,10"/>
    <CheckBox x:Name="EnterpriseAttestation" Content="Require enterprise attestation"/>
    <TextBlock Text="Requires a YubiKey provisioned for enterprise attestation." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="20,3,0,0"/>
   </StackPanel></Expander>
   <TextBlock Text="Reset before setup" Style="{StaticResource SectionTitle}" Margin="0,8"/>
   <CheckBox x:Name="ResetProfile" Content="Clear existing FIDO passkeys and PIN before setup"/>
   <TextBlock x:Name="ResetWarning" Text="This cannot be undone. The operator must confirm before the selected key is erased." TextWrapping="Wrap" Foreground="#A4262C" Margin="0,5,0,0"/>
   <TextBlock Text="Compatibility" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
   <TextBlock x:Name="RequirementsText" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
