<Window x:Class="YubiEnroll.UI.RemoveRegistrationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Remove registration" Icon="pack://application:,,,/Assets/App.ico" Width="500" SizeToContent="Height"
 ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="White"
 FontFamily="Segoe UI" FontSize="14" FocusManager.FocusedElement="{Binding ElementName=CancelAction}">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button x:Name="CancelAction" Content="Cancel" IsCancel="True" IsDefault="True"/>
   <Button x:Name="RemoveAction" Content="Remove" Style="{StaticResource DangerButton}" Click="Remove_Click" Margin="0"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="Remove this registration from Entra?" Style="{StaticResource SettingsTitle}"/>
    <TextBlock x:Name="KeyName" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,2"/>
    <TextBlock x:Name="KeyModel" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    <TextBlock x:Name="DatesLabel" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Tenant" Foreground="{StaticResource Muted}" Margin="0,0,16,6"/>
     <TextBlock Grid.Column="1" x:Name="TenantLabel" TextWrapping="Wrap"/>
     <TextBlock Grid.Row="1" Text="User" Foreground="{StaticResource Muted}"/>
     <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UserLabel" TextWrapping="Wrap"/>
    </Grid>
    <TextBlock Text="This passkey will no longer work for this account. The YubiKey, its PIN and its other passkeys stay unchanged." TextWrapping="Wrap" Margin="0,16,0,12"/>
    <Expander Header="Details" x:Name="Details">
     <StackPanel Margin="0,8,0,0">
      <TextBlock Text="User ID"/><TextBox x:Name="UserId" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="User ID" Margin="0,4,0,8"/>
      <TextBlock Text="Registration ID"/><TextBox x:Name="RegistrationId" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Registration ID" Margin="0,4,0,0"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
